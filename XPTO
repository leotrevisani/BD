-- ========================================================
-- XPTO LTDA - CONTROLE DE PESSOAL
-- ========================================================
CREATE DATABASE IF NOT EXISTS XPTO_LTDA;
USE XPTO_LTDA;

-- 1. Tabela SETOR
CREATE TABLE IF NOT EXISTS setor (
    cod_setor VARCHAR(5) PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL,
    ramal VARCHAR(10) NOT NULL
);

-- 2. Tabela CARGO
CREATE TABLE IF NOT EXISTS cargo (
    cod_cargo INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL,
    salario DECIMAL(10,2) NOT NULL
);

-- 3. Tabela FUNCIONARIOS
CREATE TABLE IF NOT EXISTS funcionarios (
    cod_func INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    admissao DATE NOT NULL,
    cod_cargo INT NOT NULL,
    cod_setor VARCHAR(5) NOT NULL,
    FOREIGN KEY (cod_cargo) REFERENCES cargo(cod_cargo),
    FOREIGN KEY (cod_setor) REFERENCES setor(cod_setor)
);

