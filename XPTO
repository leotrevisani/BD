-- Consultas do enunciado
-- Nomes e datas de admissão
SELECT nome, admissao FROM funcionarios;
-- Cargo de um funcionário
SELECT f.nome, c.descricao AS cargo FROM funcionarios f JOIN cargo c ON f.cod_cargo = c.cod_cargo WHERE f.cod_func = 1;
-- Salário e ramal do funcionário
SELECT f.nome, c.salario, s.ramal FROM funcionarios f JOIN cargo c ON f.cod_cargo = c.cod_cargo JOIN setor s ON f.cod_setor = s.cod_setor;
