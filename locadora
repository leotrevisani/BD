-- DROP DATABASE VIDEOLOCADORA;

CREATE DATABASE VIDEOLOCADORA; 

USE VIDEOLOCADORA;

-- CRIAÇÃO DAS TABELAS

CREATE TABLE CLIENTES
(
	COD_CLIENTE INTEGER AUTO_INCREMENT PRIMARY KEY NOT NULL,
	RG VARCHAR(9) NOT NULL,
	NOME VARCHAR(50) NOT NULL,
	ENDERECO VARCHAR(50) NULL,
	BAIRRO VARCHAR(30) NULL,
	CIDADE VARCHAR(30) NULL, 
	ESTADO CHAR(2) NOT NULL,
	TELEFONE VARCHAR(15) NULL,
	EMAIL VARCHAR(30) NULL,
	DATANASCIMENTO DATETIME NULL,
	sexo char(1)
);

CREATE TABLE CATEGORIA
(
	COD_CATEGORIA INTEGER AUTO_INCREMENT PRIMARY KEY NOT NULL,
	NOME_CATEGORIA VARCHAR(20) NOT NULL
);

CREATE TABLE FILME
(
	COD_FILME INTEGER AUTO_INCREMENT PRIMARY KEY NOT NULL,
	FILME VARCHAR(30) NOT NULL,
	COD_CATEGORIA INTEGER NOT NULL,
	DIRETOR VARCHAR(50) NOT NULL,
	VALOR_LOCACAO FLOAT NOT NULL,
	RESERVADA CHAR(1) NOT NULL
);

CREATE TABLE LOCACOES
(
	COD_LOCACAO INTEGER AUTO_INCREMENT NOT NULL,
	COD_CLIENTE INTEGER NOT NULL,
	COD_FILME INTEGER NOT NULL,
	DATA_RETIRADA DATETIME NOT NULL,
	DATA_DEVOLUCAO DATETIME NULL,
	CONSTRAINT PK_LOCACAO_CLIENTE PRIMARY KEY(COD_LOCACAO, COD_CLIENTE, COD_FILME)
);


-- CRIAÇÃO DOS RELACIONAMENTOS 
-- LOCACAO - CLIENTES

ALTER TABLE LOCACOES ADD CONSTRAINT FK_LOCACOES_CLIENTE FOREIGN KEY (COD_CLIENTE)
REFERENCES CLIENTES(COD_CLIENTE);


-- ALTER TABLE dbo.LOCACOES CHECK CONSTRAINT FK_LOCACOES_CLIENTE 

-- LOCACOES - FILME
ALTER TABLE LOCACOES ADD CONSTRAINT FK_LOCACOES_FILME FOREIGN KEY (COD_FILME)
REFERENCES FILME(COD_FILME);


-- ALTER TABLE dbo.LOCACOES CHECK CONSTRAINT FK_LOCACOES_FILME 


-- FILME - CATEGORIA
ALTER TABLE FILME ADD CONSTRAINT FK_CATEGORIA_FILME FOREIGN KEY (COD_CATEGORIA)
REFERENCES CATEGORIA(COD_CATEGORIA);


