-- Total de vencimentos e descontos do funcionário na competência
SELECT
	SUM(CASE WHEN pd.tipo = 'V' THEN p.valor ELSE 0 END) AS total_vencimentos,
  SUM(CASE WHEN pd.tipo = 'D' THEN p.valor ELSE 0 END) AS total_descontos
FROM possui p JOIN prov_desc pd ON p.cod_prov = pd.cod_prov
WHERE p.cod_fil = 1 AND p.cod_fun = 1 AND p.competencia = '2016-01';
