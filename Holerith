-- RECIBO DE PAGAMENTO / HOLERITE (3FN)
CREATE DATABASE IF NOT EXISTS holerith;
USE holerith;

-- 1. Tabela FILIAIS
CREATE TABLE IF NOT EXISTS filiais (
    cod_fil INT AUTO_INCREMENT PRIMARY KEY,
    razao VARCHAR(150) NOT NULL,
    logradouro VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    estado CHAR(2),
    cep VARCHAR(10),
    cnpj VARCHAR(20),
    salario_base DECIMAL(10,2)
);

-- 2. Tabela CLIENTES (cada cliente pertence a 1 filial)
CREATE TABLE IF NOT EXISTS clientes (
    cod_cli INT AUTO_INCREMENT PRIMARY KEY,
    razao VARCHAR(150) NOT NULL,
    logradouro VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    estado CHAR(2),
    cep VARCHAR(10),
    cnpj VARCHAR(20),
    cod_fil INT NOT NULL,
    FOREIGN KEY (cod_fil) REFERENCES filiais(cod_fil)
);

-- 3. Tabela DEPARTAMENTO
CREATE TABLE IF NOT EXISTS departamento (
    cod_dep INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL
);

-- 4. Tabela CARGOS
CREATE TABLE IF NOT EXISTS cargos (
    cod_cargo INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL
);

-- 5. Tabela FUNCIONARIOS (chave composta: filial + código do funcionário)
CREATE TABLE IF NOT EXISTS funcionarios (
    cod_fil INT NOT NULL,
    cod_fun INT NOT NULL,
    nome VARCHAR(150) NOT NULL,
    admissao DATE NOT NULL,
    salario DECIMAL(10,2) NOT NULL,
    cod_dep INT NOT NULL,
    cod_cargo INT NOT NULL,
    PRIMARY KEY (cod_fil, cod_fun),
    FOREIGN KEY (cod_fil) REFERENCES filiais(cod_fil),
    FOREIGN KEY (cod_dep) REFERENCES departamento(cod_dep),
    FOREIGN KEY (cod_cargo) REFERENCES cargos(cod_cargo)
);

-- 6. Tabela PROV_DESC (proventos e descontos)
CREATE TABLE IF NOT EXISTS prov_desc (
    cod_prov INT PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL,
    tipo CHAR(1) NOT NULL, -- V = Vencimento, D = Desconto
    inss CHAR(1),
    fgts CHAR(1),
    irrf CHAR(1)
);

-- 7. Tabela POSSUI (itens do holerite: funcionário x provento/desconto x competência)
CREATE TABLE IF NOT EXISTS possui (
    cod_fil INT NOT NULL,
    cod_fun INT NOT NULL,
    cod_prov INT NOT NULL,
    competencia CHAR(7) NOT NULL, -- formato AAAA-MM
    fator_h_d DECIMAL(10,2),
    valor DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (cod_fil, cod_fun, cod_prov, competencia),
    FOREIGN KEY (cod_fil, cod_fun) REFERENCES funcionarios(cod_fil, cod_fun),
    FOREIGN KEY (cod_prov) REFERENCES prov_desc(cod_prov)
);

