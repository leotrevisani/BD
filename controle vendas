-- ========================================================
-- CONTROLE DE VENDAS
-- ========================================================
CREATE DATABASE IF NOT EXISTS controle_vendas;
USE bd_vendas;

-- 1. Tabela FILIAIS
CREATE TABLE IF NOT EXISTS filiais (
    cod_filial INT AUTO_INCREMENT PRIMARY KEY,
    razao_social VARCHAR(150) NOT NULL,
    rua VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    estado CHAR(2),
    cep VARCHAR(10),
    site VARCHAR(100),
    email VARCHAR(100)
);

-- 2. Tabela CLIENTES
CREATE TABLE IF NOT EXISTS clientes (
    cod_cli INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    rua VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    estado CHAR(2),
    cep VARCHAR(10)
);

-- 3. Tabela VENDEDORES
CREATE TABLE IF NOT EXISTS vendedores (
    cod_ven INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL
);

-- 4. Tabela CONDICOES DE PAGAMENTO
CREATE TABLE IF NOT EXISTS cond_pagto (
    cod_cond INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL
);

-- 5. Tabela PRODUTOS
CREATE TABLE IF NOT EXISTS produtos (
    cod_prod INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL,
    tipo_uni VARCHAR(10),
    pre_uni_vend DECIMAL(10,2) NOT NULL
);

-- 6. Tabela VENDAS
CREATE TABLE IF NOT EXISTS vendas (
    cod_fil INT NOT NULL,
    num_ped INT NOT NULL,
    cod_cli INT NOT NULL,
    cod_ven INT NOT NULL,
    cod_cond INT NOT NULL,
    data_emissao DATE NOT NULL,
    prazo INT,
    observacoes TEXT,
    frete DECIMAL(10,2),
    avisos_cli TEXT,
    PRIMARY KEY (cod_fil, num_ped),
    FOREIGN KEY (cod_fil) REFERENCES filiais(cod_filial),
    FOREIGN KEY (cod_cli) REFERENCES clientes(cod_cli),
    FOREIGN KEY (cod_ven) REFERENCES vendedores(cod_ven),
    FOREIGN KEY (cod_cond) REFERENCES cond_pagto(cod_cond)
);

-- 7. Tabela ITENS DAS VENDAS
CREATE TABLE IF NOT EXISTS itens_venda (
    cod_fil INT NOT NULL,
    num_ped INT NOT NULL,
    item INT NOT NULL,
    cod_pro INT NOT NULL,
    qtde INT NOT NULL,
    desconto DECIMAL(5,2) DEFAULT 0.00,
    PRIMARY KEY (cod_fil, num_ped, item),
    FOREIGN KEY (cod_fil, num_ped) REFERENCES vendas(cod_fil, num_ped),
    FOREIGN KEY (cod_pro) REFERENCES produtos(cod_prod)
);

