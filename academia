-- Quais alunos frequentam a Musculação
SELECT al.nome FROM alunos al JOIN frequenta f ON al.cod_alu = f.cod_alu JOIN aulas au ON f.cod_aula = au.cod_aula WHERE au.descricao = 'Musculação';
-- Especialidades de cada professor
SELECT p.nome, e.descricao FROM professores p JOIN espec_profe ep ON p.cref = ep.cref JOIN especialidades e ON ep.cod_esp = e.cod_esp;
