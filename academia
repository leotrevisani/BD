-- ========================================================
-- ACADEMIA CORPO PERFEITO
-- ========================================================
CREATE DATABASE IF NOT EXISTS academia_CP;
USE academia_CP;

-- 1. Tabela PROFESSORES
CREATE TABLE IF NOT EXISTS professores (
    cref VARCHAR(15) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    telefone VARCHAR(15),
    endereco VARCHAR(150)
);

-- 2. Tabela AULAS (cada aula é lecionada por um único professor)
CREATE TABLE IF NOT EXISTS aulas (
    cod_aula INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL,
    cref VARCHAR(15) NOT NULL,
    FOREIGN KEY (cref) REFERENCES professores(cref)
);

-- 3. Tabela ALUNOS
CREATE TABLE IF NOT EXISTS alunos (
    cod_alu INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    telefone VARCHAR(15),
    email VARCHAR(100),
    sexo CHAR(1),
    endereco VARCHAR(150)
);

-- 4. Tabela FREQUENTA (aluno x aula)
CREATE TABLE IF NOT EXISTS frequenta (
    cod_alu INT NOT NULL,
    cod_aula INT NOT NULL,
    PRIMARY KEY (cod_alu, cod_aula),
    FOREIGN KEY (cod_alu) REFERENCES alunos(cod_alu),
    FOREIGN KEY (cod_aula) REFERENCES aulas(cod_aula)
);

-- 5. Tabela ESPECIALIDADES
CREATE TABLE IF NOT EXISTS especialidades (
    cod_esp INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(50) NOT NULL
);

-- 6. Tabela ESPEC_PROFE (professor x especialidade)
CREATE TABLE IF NOT EXISTS espec_profe (
    cref VARCHAR(15) NOT NULL,
    cod_esp INT NOT NULL,
    PRIMARY KEY (cref, cod_esp),
    FOREIGN KEY (cref) REFERENCES professores(cref),
    FOREIGN KEY (cod_esp) REFERENCES especialidades(cod_esp)
);

