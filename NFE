-- NOTA FISCAL ELETRÔNICA (3FN)
CREATE DATABASE IF NOT EXISTS nota_fiscal_eletronoca;
USE nota_fiscal_eletronoca;

-- 1. Tabela FILIAIS
CREATE TABLE IF NOT EXISTS filiais (
    id_filial INT AUTO_INCREMENT PRIMARY KEY,
    razao_social VARCHAR(150) NOT NULL,
    logradouro VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    uf CHAR(2),
    cep VARCHAR(10),
    fone VARCHAR(15),
    site VARCHAR(100),
    email VARCHAR(100),
    cnpj VARCHAR(20),
    insc_estad VARCHAR(20),
    por_med_imp DECIMAL(5,2)
);

-- 2. Tabela CLIENTES
CREATE TABLE IF NOT EXISTS clientes (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    logradouro VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    uf CHAR(2),
    cep VARCHAR(10),
    fone VARCHAR(15),
    email VARCHAR(100),
    cpf VARCHAR(15),
    rg VARCHAR(15),
    cnpj VARCHAR(20),
    insc_estad VARCHAR(20)
);

-- 3. Tabela NATUREZAS (natureza da operação)
CREATE TABLE IF NOT EXISTS naturezas (
    id_nat INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL,
    cfop VARCHAR(10),
    base_icms DECIMAL(10,2),
    por_icms DECIMAL(5,2),
    base_ipi DECIMAL(10,2),
    por_ipi DECIMAL(5,2)
);

-- 4. Tabela TRANSPORTADORAS
CREATE TABLE IF NOT EXISTS transportadoras (
    id_trans INT AUTO_INCREMENT PRIMARY KEY,
    razao_social VARCHAR(150) NOT NULL,
    logradouro VARCHAR(100),
    numero VARCHAR(10),
    complemento VARCHAR(50),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    uf CHAR(2),
    cep VARCHAR(10),
    cnpj VARCHAR(20),
    insc_estad VARCHAR(20),
    placa VARCHAR(10),
    cod_antt VARCHAR(20)
);

-- 5. Tabela PRODUTOS
CREATE TABLE IF NOT EXISTS produtos (
    cod_prod INT AUTO_INCREMENT PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL,
    descricao_compl VARCHAR(150),
    ncm VARCHAR(10),
    cst VARCHAR(5),
    tipo_unid VARCHAR(10),
    valor_unit DECIMAL(10,2) NOT NULL
);

-- 6. Tabela NOTAS_FISCAIS (chave composta: filial + número da nota)
CREATE TABLE IF NOT EXISTS notas_fiscais (
    id_filial INT NOT NULL,
    num_nfe INT NOT NULL,
    serie VARCHAR(5),
    tipo_e_s CHAR(1), -- E = Entrada, S = Saída
    chave VARCHAR(50),
    protocolo VARCHAR(30),
    datahora_prot DATETIME,
    datahora_emissao DATETIME NOT NULL,
    datahora_saida DATETIME,
    frete_por_conta CHAR(1),
    qtde INT,
    especie VARCHAR(30),
    marca VARCHAR(30),
    numeracao VARCHAR(30),
    peso_bruto DECIMAL(10,3),
    peso_liquido DECIMAL(10,3),
    inf_complem TEXT,
    id_cliente INT NOT NULL,
    id_trans INT,
    id_nat INT NOT NULL,
    PRIMARY KEY (id_filial, num_nfe),
    FOREIGN KEY (id_filial) REFERENCES filiais(id_filial),
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
    FOREIGN KEY (id_trans) REFERENCES transportadoras(id_trans),
    FOREIGN KEY (id_nat) REFERENCES naturezas(id_nat)
);

-- 7. Tabela ITENS_NF (produtos de cada nota fiscal)
CREATE TABLE IF NOT EXISTS itens_nf (
    id_filial INT NOT NULL,
    num_nfe INT NOT NULL,
    item INT NOT NULL,
    cod_prod INT NOT NULL,
    qtde DECIMAL(10,2) NOT NULL,
    desconto DECIMAL(10,2) DEFAULT 0.00,
    PRIMARY KEY (id_filial, num_nfe, item),
    FOREIGN KEY (id_filial, num_nfe) REFERENCES notas_fiscais(id_filial, num_nfe),
    FOREIGN KEY (cod_prod) REFERENCES produtos(cod_prod)
);

